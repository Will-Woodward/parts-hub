generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockType { OWN CONSIGNMENT }
enum ProductStatus { DRAFT ACTIVE HIDDEN SOLD_OUT }
enum OrderStatus { PENDING_PAYMENT PAID PROCESSING SHIPPED COMPLETED CANCELLED REFUND_PENDING REFUNDED }
enum PaymentChannel { WECHAT ALIPAY BANK_TRANSFER OFFLINE }
enum PaymentStatus { CREATED PENDING SUCCESS FAILED CLOSED REFUNDED }

model Product {
  id              String        @id @default(cuid())
  partNumber      String        @unique
  manufacturer    String
  category        String?
  description     String?       @db.Text
  dateCode        String?
  packageType     String?
  condition       String        @default("New & Unused")
  originalPacking Boolean       @default(false)
  moq             Int           @default(1)
  unitPriceFen    Int
  currency        String        @default("CNY")
  status          ProductStatus @default(DRAFT)
  images          ProductImage[]
  inventory       Inventory?
  orderItems      OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([manufacturer])
  @@index([status, partNumber])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([productId, sortOrder])
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  stockType       StockType
  supplierName    String?
  physicalLocation String?
  physicalQty     Int      @default(0)
  reservedQty     Int      @default(0)
  soldQty         Int      @default(0)
  consignmentEnds DateTime?
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  logs            InventoryLog[]
  updatedAt       DateTime @updatedAt
  @@index([stockType, physicalLocation])
}

model InventoryLog {
  id            String    @id @default(cuid())
  inventoryId   String
  changeQty     Int
  reason        String
  referenceType String?
  referenceId   String?
  createdBy     String?
  inventory     Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  @@index([inventoryId, createdAt])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  orders    Order[]
  createdAt DateTime @default(now())
  @@index([email])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerId     String
  status         OrderStatus @default(PENDING_PAYMENT)
  subtotalFen    Int
  shippingFen    Int           @default(0)
  totalFen       Int
  currency       String        @default("CNY")
  paymentDeadline DateTime?
  customer       Customer      @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  partNumber     String
  manufacturer   String
  quantity       Int
  unitPriceFen   Int
  lineTotalFen   Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])
}

model Payment {
  id                String         @id @default(cuid())
  orderId           String
  channel           PaymentChannel
  status            PaymentStatus  @default(CREATED)
  amountFen         Int
  providerTradeNo   String?
  providerTransactionId String?
  notifyPayload     Json?
  paidAt            DateTime?
  order             Order          @relation(fields: [orderId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  @@index([orderId, status])
  @@unique([channel, providerTradeNo])
}
